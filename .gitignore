# ========== 凭据与本地环境（绝对不能提交） ==========
.env
.env.*
!.env.example
*.kubeconfig
kubeconfig
helm-values.backup.yaml

# ========== 本机工作区数据 ==========
.workbuddy/
.local/
collector-state/
*.state.json

# ========== 构建产物 / 二进制（用 go build 生成） ==========
dist/
*.exe
*.dll
*.so
*.dylib
# 仅忽略根目录的 go build 产物，不能写成 exporter / collector（会误伤源码目录）
/exporter
/collector
/ops-exporter-linux-amd64
/jenkins-collector-linux-amd64

# ========== 运行时与临时文件 ==========
*.log
*.tmp
*.swp
.DS_Store
render-check*.yaml
render-check*.err

# ========== Go 测试与覆盖率 ==========
coverage.out
coverage.html
*.test

# 说明：vendor/ 必须提交（离线构建依赖），不要加到这里。
