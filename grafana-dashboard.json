    {
      "id": 41,
      "type": "stat",
      "title": "失败构建数（24h）",
      "description": "近 24h status=failed 的构建数。unstable/aborted 不计入失败（见 buildupdater.go）。非零即红。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jenkins_build_failure_total[24h])) or (count(jenkins_build_failure_total) > 0) * 0",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 42,
      "type": "stat",
      "title": "构建成功率（24h）",
      "description": "1 - 失败/总数。clamp_min 防除零；and 保证无数据时显示 No data 而非 100% 假绿。低于 95% 变黄、90% 变红。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (sum(increase(jenkins_build_failure_total[24h])) / clamp_min(sum(increase(jenkins_build_total[24h])), 1))) and (count(jenkins_build_total) > 0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      }
    },
