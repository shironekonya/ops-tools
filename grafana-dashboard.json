  "title": "Ops Exporter - 任务与 Jenkins 构建状态",
  "uid": "ops-exporter",
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "失败任务数",
      "description": "当前 last_status=0 的任务数量。任何非零值都应立即处理。表达式为或运算：有任务但无失败时显式给 0，完全没数据时才显示 No data（避免假绿）。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ops_job_last_status == 0) or (count(ops_job_last_status) > 0) * 0",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "任务总数",
      "description": "exporter 当前采集到的任务数量（结果目录中的任务文件数）。",
      "gridPos": {
        "h": 4,
