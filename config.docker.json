{
  "listen_addr": ":9105",
  "result_dir": "/data/log",
  "refresh_interval": "10s",
  "log_level": "info",
  "ingest": {
    "max_body_bytes": 1048576,
    "max_build_age": "168h",
    "expiry_interval": "5m"
  },
  "http": {
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "60s",
    "shutdown_timeout": "5s",
    "max_header_bytes": 1048576
  }
}
