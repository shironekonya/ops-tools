# 统一行尾，避免 Windows 提交后镜像/脚本出现 CRLF 问题。
* text=auto

*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.sh       text eol=lf
Dockerfile* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制不做行尾转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
