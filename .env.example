# 复制为 .env 后填入真实值（.env 不应提交到版本库）。
# Collector 认证：Jenkins 用户名 + API Token（不硬编码进镜像/配置文件）
# 目标 Jenkins: http://<TARGET_HOST>:8081/（强制认证）
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=

# 监控告警栈（Prometheus / Grafana / Alertmanager）走 Rancher Monitoring，
# 不在此 compose 部署。告警通知用 Alertmanager 原生 receiver（email / webhook），
# SMTP 凭据在 Rancher Monitoring 的 Alertmanager 配置中设置，不放在本文件。
